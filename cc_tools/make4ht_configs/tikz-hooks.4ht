% PATCHED by cc-tools (PhenomML/cc-tools#44):
% \find:externalize fires for EVERY \usetikzlibrary call (because the appended
% code injects "external" unconditionally into each call's argument string).
% After the second firing, \tikz:externalize becomes self-referential:
%   \let\tikz:externalize\tikzexternalize  (which calls \tikz:externalize)
% → infinite recursion → TeX grouping-levels=255 overflow on the first call to
% \tikzexternalize.  The guard below ensures the wrapping runs exactly once.
\immediate\write-1{version 2025-11-20-13:54 (cc-tools #44 patch)}

\ifdefined\pgfsysdriver\else%
  \typeout{*****************************}
  \typeout{TeX4ht info: Using dvisvgm4ht TikZ driver. Put \detokenize{\def\pgfsysdriver{driver-name}} to your
  document before use of TikZ if you want to another driver. Use tikz+ option if your TikZ pictures use patterns.}%
  \def\pgfsysdriver{pgfsys-dvisvgm4ht.def}%
\fi%
\ifdefined\find:externalize\else
\:AtEndOfPackage{%
\let\use:tikzlibrary\usetikzlibrary
\def\find:externalize#1external#2\@nil{%
  \ifdefined\tikzexternalize
    \ifdefined\tikzext:wrap:done\else%
      \global\let\tikzext:wrap:done\relax%
      \let\tikz:externalize\tikzexternalize
      \renewcommand\tikzexternalize[1][]{\begingroup\let\orig:includegraphics\includegraphics\tikz:externalize[##1,mode=only graphics]\endgroup}
      \tikzset{%
        tex4ht inc/.style={%
          /pgf/images/include external/.code={%
            % it seems that \includegraphics is redefined inside \tikzeexternalize,
            % so we need to use saved version to prevent errors
            \orig:includegraphics[]{####1.pdf}%
          }%
        }%
      }%
      \tikzset{tex4ht inc}%
    \fi%
  \fi%
}
\append:defI\use@@tikzlibrary{\find:externalize##1external\@nil}%
}
\fi
