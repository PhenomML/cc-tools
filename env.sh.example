#!/bin/sh
# cc-tools environment configuration
# Copy to ~/.config/cc-tools/env.sh and follow the instructions below.
#
# This file contains only retrieval commands — no secrets.
# Secrets are stored in the macOS Keychain via the `security` CLI.

export CC_TOOLS="/path/to/cc-tools"  # set to your cc-tools clone
export PATH="$CC_TOOLS/.venv/bin:$PATH"

# Semantic Scholar API key
# Request at: https://www.semanticscholar.org/product/api
# Store with: security add-generic-password -a "cc-tools" -s "S2_API_KEY" -w "<key>"
# Without a key the tool works at ~100 req/5min (unauthenticated rate limit).
export S2_API_KEY=$(security find-generic-password -a "cc-tools" -s "S2_API_KEY" -w 2>/dev/null)
